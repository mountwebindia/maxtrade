{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run MaxTrade dashboard",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": [
				"-m",
				"streamlit",
				"run",
				"app.py",
				"--server.address=127.0.0.1",
				"--server.port=8501",
				"--server.headless=true",
				"--browser.gatherUsageStats=false"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}